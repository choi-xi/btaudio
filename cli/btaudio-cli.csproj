<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>btaudio</AssemblyName>
    <RootNamespace>BtAudioSink</RootNamespace>
    <Version>1.0.0</Version>
    <Product>btaudio</Product>
    <Description>让手机通过蓝牙把声音送到电脑播放（Windows A2DP Sink 接收端，命令行版）</Description>
    <Company>btaudio</Company>
    <Copyright>MIT License</Copyright>
    <ApplicationIcon>..\shared\app.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
